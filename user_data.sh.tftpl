#!/bin/bash
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y nginx curl

TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600" || true)
if [ -n "$TOKEN" ]; then
  INSTANCE_ID=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id || echo "unknown")
  PRIVATE_IP=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4 || echo "unknown")
else
  INSTANCE_ID="unknown"
  PRIVATE_IP="unknown"
fi

SUFFIX="${INSTANCE_ID: -3}"
NUM=$((10#${SUFFIX:-0} % 3 + 1))
SERVER_LABEL="Server ${NUM}"

cat > /var/www/html/index.html <<HTML
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Terraform AWS Auto Scaling</title>
<style>
body { font-family: Arial,sans-serif; margin:0; background:#f3f6fb; color:#172033; }
header { background:#172554; color:white; padding:28px 20px; text-align:center; }
main { max-width:900px; margin:28px auto; padding:0 18px; }
.card { background:white; border-radius:14px; padding:24px; box-shadow:0 5px 18px #0001; }
.pill { display:inline-block; background:#dbeafe; color:#1d4ed8; padding:8px 12px; border-radius:999px; font-weight:bold; }
.details { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:14px; margin-top:20px; }
.detail { background:#f8fafc; padding:16px; border-radius:10px; overflow-wrap:anywhere; }
small { color:#64748b; }
</style>
</head>
<body>
<header><h1>AWS Auto Scaling Project</h1><p>Terraform + EC2 + Application Load Balancer + Auto Scaling</p></header>
<main><section class="card">
<span class="pill">${SERVER_LABEL}</span>
<h2>Hello from ${SERVER_LABEL}</h2>
<p>This page is served by an EC2 instance registered with the Application Load Balancer.</p>
<div class="details">
<div class="detail"><small>Server label</small><h3>${SERVER_LABEL}</h3></div>
<div class="detail"><small>Instance ID</small><h3>${INSTANCE_ID}</h3></div>
<div class="detail"><small>Private IP</small><h3>${PRIVATE_IP}</h3></div>
</div></section></main>
</body>
</html>
HTML

systemctl enable nginx
systemctl restart nginx
